{
  "name": "@dcd-sdk/storage-client",
  "version": "1.0.4",
  "description": "Official Node.js & TypeScript client SDK for DevCloudDesk Storage Engine",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.ts",
        "default": "./dist/index.d.ts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs --format esm --dts --clean",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^9.0.0",
    "typescript": "^5.7.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/devclouddesk/dcd-sdk-js.git"
  },
  "keywords": [
    "devclouddesk",
    "storage",
    "cdn",
    "image-transformation",
    "cloudinary-alternative",
    "s3",
    "bucket"
  ],
  "homepage": "https://devclouddesk.com",
  "author": "DevCloudDesk Team <support@devclouddesk.com>",
  "license": "MIT"
}
